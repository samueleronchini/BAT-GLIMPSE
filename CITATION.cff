    given-names: Samuele
    affiliation: "Gran Sasso Science Institute"
url: "https://github.com/samueleronchini/BAT-GLIMPSE"
repository-code: "https://github.com/samueleronchini/BAT-GLIMPSE"
doi: "10.5281/zenodo.20692675"
license: "MIT"
references:
  - type: article
    authors:
      - family-names: Ronchini
        given-names: Samuele
    title: "Swift gives a new BAT-GLIMPSE: Gamma-ray Localization using Imaging and Mosaic techniques for Pointing and Slew Epochs"
    journal: "arXiv"
    year: 2026
    doi: "10.48550/arXiv.2607.15130"
